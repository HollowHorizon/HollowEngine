@import "hollowengine:ui/styles/theme.hss";

.image-editor-root {
    gap: 5px;
    padding: 5px;
    background: $bg-raised;
}

.image-editor-tool {
    padding: 3px 5px;
    align-items: center center;
    background: $border;
    border: 1px $border;
    border-radius: $radius;
    foreground: $text-strong;
}

.image-editor-tool:hover {
    background: $bg-pressed;
}

.image-editor-tool.selected {
    background: $bg-selected;
    border: 1px $accent;
    foreground: $white;
}

.image-editor-tool.disabled {
    opacity: 0.42;
}

.image-editor-tool-label,
.image-editor-label {
    height: fit;
    text-wrap: false;
}

.image-editor-canvas-scroll {
    background: $bg-window;
    @apply $thin-scroll;
}

.image-editor-sidebar {
    gap: 7px;
    padding: 8px 10px 8px 12px;
    background: $bg-hover;
    border-radius: $radius;
    @apply $thin-scroll;
}

.image-editor-sidebar-title {
    height: fit;
    margin: 4px 0px 0px 0px;
    foreground: $caret;
}

.image-editor-setting {
    foreground: $text-strong;
}

.image-editor-info {
    height: fit;
    foreground: $text-soft;
    text-wrap: true;
}
