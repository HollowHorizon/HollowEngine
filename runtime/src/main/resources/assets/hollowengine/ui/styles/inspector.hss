/*
 * The look of every inspector in the engine: entity components, the animator, the rig, the effect
 * editor, the timeline selection, the model and sound editors. Editors bring their own chrome and
 * canvas; everything that shows a property lives here, so a field looks the same wherever it is opened.
 *
 * The palette is the IDE's (see docking.hss): #1C1E22 the panel, #212328 fields and headings,
 * #2B2E35 hover, #6E9BDC the accent for whatever has focus or is picked. Text is set in the code font,
 * which fits far more on a line than the vanilla one.
 */

.insp-panel {
    size: 100% 100%;
    gap: 5px;
    padding: 6px;
    background: #1C1E22;
    border-radius: 6px;
    font-family: "ttf:hollowengine:fonts/jetbrains_mono_nl.ttf";
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.insp-head {
    size: 100% fit;
    gap: 5px;
    padding: 1px 2px 3px 2px;
    align-items: start center;
}

.insp-icon {
    size: 12px 12px;
    tint: #aeb8ca;
}

.insp-title {
    size: fit fit;
    grow: 1;
    foreground: #E4E9F4;
    font-size: 10px;
    wrap: false;
    text-overflow: dots;
}

.insp-subtitle {
    size: fit fit;
    foreground: #7A8698;
    font-size: 8px;
    wrap: false;
    text-overflow: dots;
}

.insp-body {
    size: 100% fit;
    gap: 3px;
}

.insp-empty-state {
    size: 100% fit;
    margin-top: 24px;
    padding: 22px 12px 18px 12px;
    gap: 10px;
    align-items: center start;
    border: 1px #2B2E35;
    border-dash: 5px 4px;
    border-radius: 8px;
}

/* A shape rather than an image: one opaque stroke, so where lines cross nothing doubles up. */
.insp-empty-icon {
    size: 26px 28px;
    shape: path("M 5.3 12.34 C 5.48 12.44 5.69 12.5 5.9 12.5 C 6.11 12.5 6.32 12.44 6.5 12.34 L 10.7 9.94 C 10.88 9.83 11.03 9.68 11.14 9.5 C 11.24 9.32 11.3 9.11 11.3 8.9 L 11.3 4.1 C 11.3 3.89 11.24 3.68 11.14 3.5 C 11.03 3.32 10.88 3.17 10.7 3.06 L 6.5 0.66 C 6.32 0.56 6.11 0.5 5.9 0.5 C 5.69 0.5 5.48 0.56 5.3 0.66 L 1.1 3.06 C 0.92 3.17 0.77 3.32 0.66 3.5 C 0.56 3.68 0.5 3.89 0.5 4.1 L 0.5 8.9 C 0.5 9.11 0.56 9.32 0.66 9.5 C 0.77 9.68 0.92 9.83 1.1 9.94 Z M 5.9 12.5 L 5.9 6.5 M 0.67 3.5 L 5.9 6.5 L 11.13 3.5 M 3.2 1.86 L 8.6 4.95", 12 13);
    fill: none;
    stroke: #8f9bad;
    stroke-width: 1.2px;
}

.insp-empty {
    size: 100% fit;
    text-align: center;
    foreground: #7A8698;
    font-size: 8px;
}

/* ---- sections ---- */

.insp-section {
    size: 100% fit;
    gap: 3px;
}

/* A plain section: a title over a hairline. */
.insp-section-title {
    size: 100% fit;
    foreground: #8f9bad;
    font-size: 8px;
    wrap: false;
    text-overflow: dots;
}

.insp-section-rule {
    size: 100% 1px;
    background: #2B2E35;
}

.insp-section-body {
    size: 100% fit;
    gap: 3px;
}

.insp-section.boxed {
    padding: 6px;
    background: #212328;
    border-radius: 5px;
}

.insp-section-head {
    size: 100% fit;
    min-height: 18px;
    gap: 5px;
    padding: 2px 5px;
    align-items: start center;
    background: #212328;
    border-radius: 4px;
    hoverable: true;
    clickable: true;
    transition: background 110ms ease-out;
}

.insp-section-head:hover { background: #2B2E35; }

.insp-section-head[expanded="true"] { background: #25282E; }

.insp-section-head .insp-section-title {
    size: fit fit;
    grow: 1;
    foreground: #C4CBDA;
    font-size: 9px;
}

.insp-section-head:hover .insp-section-title { foreground: #ffffff; }

.insp-section-icon {
    size: 11px 11px;
    tint: #8f9bad;
    transition: tint 110ms ease-out;
}

.insp-section-head:hover .insp-section-icon,
.insp-section-head[expanded="true"] .insp-section-icon { tint: #6E9BDC; }

.insp-section-head .insp-arrow {
    size: 8px 8px;
    margin: 0px;
}

.insp-section-fold .insp-section-body {
    padding: 1px 1px 5px 4px;
}

/* ---- fields ---- */

.insp-field {
    size: 100% fit;
    gap: 2px;
}

.insp-field-head {
    size: 100% fit;
    gap: 5px;
    align-items: start center;
}

.insp-label {
    size: 100% fit;
    foreground: #8f9bad;
    font-size: 8px;
}

.insp-help {
    size: 9px 9px;
    opacity: 0.45;
    cursor: hand;
}

.insp-help:hover {
    opacity: 1;
}

.insp-hint {
    size: 100% fit;
    foreground: #6A7384;
    font-size: 8px;
}

.insp-readonly {
    size: 100% fit;
    min-height: 15px;
    gap: 6px;
    align-items: start center;
}

.insp-readonly-label {
    size: fit fit;
    grow: 1;
    foreground: #8f9bad;
    font-size: 8px;
}

.insp-readonly-value {
    size: fit fit;
    foreground: #C4CBDA;
    font-size: 8px;
    wrap: false;
    text-overflow: dots;
}

.insp-input-row {
    size: 100% fit;
    gap: 3px;
    align-items: start center;
}

.insp-input {
    size: 100% fit;
    min-height: 18px;
    padding: 3px 5px;
    background: #212328;
    border-radius: 3px;
    border: 1px #2B2E35;
    foreground: #C4CBDA;
    font-size: 9px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
    text-shadow: none;
    transition: border 110ms ease-out;
}

.insp-input:hover { border: 1px #3A3E48; }

.insp-input:focus { border: 1px #6E9BDC; }

/* A field inside a bar of its own, such as a search: no frame until the pointer is on it. */
.insp-input.flat {
    min-height: 16px;
    padding: 1px 4px;
    background: none;
    border: 1px #00000000;
}

.insp-input.flat:hover { border: 1px #3A3E48; }

.insp-input.flat:focus { border: 1px #6E9BDC; }

.insp-input.numeric { text-align: right; }

/* ---- inline fields ---- */

.insp-inline-label {
    foreground: #8f9bad;
    font-size: 8px;
    wrap: false;
    text-overflow: dots;
}

.insp-inline-label.hinted {
    hoverable: true;
}

.insp-inline-label.hinted:hover { foreground: #C4CBDA; }

.insp-input.insp-inline-input {
    min-height: 15px;
    padding: 1px 4px;
}

.insp-icon-button.insp-inline-icon {
    size: 11px 11px;
}

/* ---- effect editor ---- */

.vfx-popup {
    padding: 8px;
    gap: 6px;
    background: #26282E;
    border: 1px #3A3E48;
    border-radius: 5px;
    shadow: 1px 1px 3px 0px rgba(0, 0, 0, 0.42);
}

/* A field the timeline writes: read-only, and tinted like the accent so it reads as "keyed". */
.vfx-driven {
    background: #1B2230;
    border: 1px #34507A;
    foreground: #9FB6D8;
}

.vfx-curve-dialog {
    padding: 10px;
}

.vfx-gizmo-readout {
    padding: 1px 4px;
    background: rgba(12, 13, 15, 0.8);
    border-radius: 3px;
    foreground: #E8E2D0;
    font-size: 9px;
}

.vfx-detail {
    size: 100% fit;
    gap: 3px;
    padding: 3px 0px 3px 6px;
    border-left: 1px #2B2E35;
}

.vfx-node-head {
    size: 100% fit;
    gap: 4px;
    align-items: start center;
}

/* Whether a renderer draws on particles or once; which one depends on where it sits in the tree. */
.vfx-placement {
    size: 12px 12px;
    tint: #6A7384;
    hoverable: true;
}

.vfx-placement.active { tint: #6E9BDC; }

.vfx-material-preview {
    size: 100% 96px;
    border-radius: 4px;
    background: #141518;
    clip: true;
}

.vfx-module-head {
    size: 100% fit;
    gap: 4px;
    align-items: start center;
}

.insp-check-row {
    size: 100% fit;
    min-height: 16px;
    gap: 5px;
    align-items: start center;
    hoverable: true;
    clickable: true;
}

.insp-check-label {
    size: fit fit;
    grow: 1;
    foreground: #C4CBDA;
    font-size: 8px;
}

.insp-checkbox {
    size: 11px 11px;
    checkbox-active: #6E9BDC;
    checkbox-mark: #ffffff;
}

.insp-slider { grow: 1; }

.insp-slider-value {
    size: fit fit;
    min-width: 40px;
    foreground: #C4CBDA;
    font-size: 8px;
    wrap: false;
}

.insp-vector {
    size: 100% fit;
    gap: 3px;
}

.insp-vector-cell {
    grow: 1;
    size: 0px fit;
    gap: 2px;
}

.insp-vector-label {
    size: fit fit;
    foreground: #6A7384;
    font-size: 8px;
}

.insp-nested {
    size: 100% fit;
    gap: 3px;
    padding: 4px;
    background: #212328;
    border-radius: 4px;
}

.insp-nested-head {
    size: 100% fit;
    gap: 4px;
    align-items: start center;
}

.insp-nested-body {
    size: 100% fit;
    gap: 4px;
    padding: 0px 0px 0px 5px;
}

.insp-list-item {
    size: 100% fit;
    gap: 4px;
    align-items: start start;
}

/* ---- pills, buttons ---- */

.insp-pill-flow {
    size: 100% fit;
    gap: 3px;
}

.insp-pill {
    padding: 2px 6px;
    background: #212328;
    border-radius: 3px;
    border: 1px #2B2E35;
    hoverable: true;
    clickable: true;
    transition: background 110ms ease-out, border 110ms ease-out;
}

.insp-pill:hover { background: #2B2E35; }

.insp-pill.active {
    background: rgba(110, 155, 220, 0.2);
    border: 1px #6E9BDC;
}

.insp-pill-label {
    size: fit fit;
    foreground: #aeb8ca;
    font-size: 8px;
    wrap: false;
}

.insp-pill.active .insp-pill-label { foreground: #ffffff; }

.insp-icon-button {
    size: 14px 14px;
    tint: #8f9bad;
    hoverable: true;
    clickable: true;
    transition: tint 110ms ease-out;
}

.insp-icon-button:hover { tint: #ffffff; }

.insp-icon-button.active { tint: #6E9BDC; }

.insp-icon-button.danger:hover { tint: #E07A7A; }

.insp-pick-button {
    size: 18px 18px;
    padding: 3px;
    background: #212328;
    border-radius: 3px;
    border: 1px #2B2E35;
}

.insp-pick-button:hover { background: #2B2E35; }

.insp-button {
    size: 100% fit;
    min-height: 18px;
    gap: 5px;
    padding: 3px 8px;
    align-items: center center;
    background: #2B2E35;
    border-radius: 4px;
    hoverable: true;
    clickable: true;
    transition: background 110ms ease-out;
}

.insp-button:hover { background: #353943; }

.insp-button.primary { background: #3E5F8F; }

.insp-button.primary:hover { background: #4A6FA5; }

.insp-button.danger { background: rgba(194, 87, 87, 0.18); }

.insp-button.danger:hover { background: rgba(194, 87, 87, 0.32); }

.insp-button-icon {
    size: 11px 11px;
    tint: #C4CBDA;
}

.insp-button.primary .insp-button-icon { tint: #ffffff; }

.insp-button-label {
    size: fit fit;
    foreground: #C4CBDA;
    font-size: 8px;
    wrap: false;
}

.insp-button.primary .insp-button-label { foreground: #ffffff; }

.insp-button.danger .insp-button-label { foreground: #E79797; }

/* ---- asset picker ---- */

.insp-dialog {
    gap: 6px;
    padding: 10px;
    background: #26282E;
    border-radius: 6px;
    border: 1px #3A3E48;
    shadow: 2px 2px 10px 0px rgba(0, 0, 0, 0.5);
    font-family: "ttf:hollowengine:fonts/jetbrains_mono_nl.ttf";
}

.insp-dialog-head {
    size: 100% fit;
    gap: 6px;
    align-items: start center;
}

.insp-dialog-title {
    size: fit fit;
    foreground: #E4E9F4;
    font-size: 10px;
    wrap: false;
    text-overflow: dots;
}

.insp-search {
    size: 100% fit;
    min-height: 20px;
    gap: 5px;
    padding: 1px 5px;
    align-items: start center;
    background: #212328;
    border-radius: 4px;
}

.insp-search-icon {
    size: 11px 11px;
    tint: #8f9bad;
}

.insp-asset-tree {
    width: 100%;
    background: #212328;
    border-radius: 4px;
    padding: 3px;
}

/* ---- bone picker ---- */

.insp-bone {
    padding: 3px 5px;
    gap: 4px;
    background: #212328;
    border-radius: 3px;
    border: 1px #2B2E35;
    foreground: #C4CBDA;
    transition: border 110ms ease-out;
}

.insp-bone:hover { border: 1px #6E9BDC; }

.insp-bone.empty .insp-bone-label { foreground: #6A7384; }

.insp-bone-label {
    font-size: 8px;
}

.insp-bone-popup {
    size: 190px fit;
    max-height: 220px;
    padding: 4px;
    gap: 4px;
}

.insp-bone-list {
    size: 100% fit;
    max-height: 180px;
}

/* ---- disclosure ---- */

.insp-arrow {
    size: 10px 10px;
    margin: 0px 2px;
    shape: path("M 3 2 L 8 6 L 3 10", 12 12);
    fill: none;
    stroke: #7f8a9d;
    stroke-width: 1.5px;
    transition: rotate 120ms ease-out;
}

.insp-arrow[expanded="false"] { rotate: 0px 0px 0px; }
.insp-arrow[expanded="true"] { rotate: 0px 0px 90px; }
