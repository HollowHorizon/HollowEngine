/*
 * The notification stack in the bottom-right corner. Each card is bordered with its own kind's
 * gradient, matching the icon it carries; the rest follows the IDE's popups, compact and quiet.
 */

.notif-stack {
    size: fit fit;
    gap: 6px;
    margin: 10px;
    align: end end;
}

.notif {
    size: 280px fit;
    gap: 5px;
    padding: 7px 8px 7px 10px;
    background: rgba(33, 35, 40, 0.96);
    border-radius: 8px;
    border: 1px #2E3138;
    backdrop-filter: blur(8px);
    shadow: 0px 6px 16px 0px rgba(0, 0, 0, 0.45);
}

.notif.success { border: 1px linear-gradient(135deg, #9BF763, #3D5A24); }
.notif.error { border: 1px linear-gradient(135deg, #FF759F, #6E2020); }
.notif.warning { border: 1px linear-gradient(135deg, #F7C363, #6B4520); }
.notif.info { border: 1px linear-gradient(135deg, #4C86E0, #12203F); }
.notif.progress { border: 1px linear-gradient(135deg, #4C86E0, #12203F); }

.notif-head {
    size: 100% fit;
    gap: 8px;
    align-items: start center;
}

.notif-icon {
    size: 16px 16px;
}

.notif-title {
    size: fit fit;
    foreground: #E4E9F4;
    text-overflow: dots;
}

.notif-action {
    size: fit fit;
    min-height: 18px;
    padding: 2px 8px;
    background: #2B2E35;
    border-radius: 4px;
    hoverable: true;
    clickable: true;
    transition: background 120ms ease-out;
}

.notif-action:hover { background: #363A43; }

.notif-action-label {
    align: center center;
    size: fit fit;
    foreground: #D7DEEA;
    wrap: false;
}

.notif-close {
    size: 16px 16px;
    padding: 4px;
    background: #00000000;
    border-radius: 4px;
    tint: #7A8698;
    transition: tint 120ms ease-out, background 120ms ease-out;
}

.notif-close:hover {
    background: #2B2E35;
    tint: #E4E9F4;
}

.notif-track {
    size: 100% 3px;
    background: #2B2E35;
    border-radius: 2px;
    clip: true;
}

.notif-fill {
    background: linear-gradient(90deg, #4C86E0, #9BC2FF);
    border-radius: 2px;
}

.notif.success .notif-fill { background: linear-gradient(90deg, #70A832, #9BF763); }
.notif.error .notif-fill { background: linear-gradient(90deg, #F54747, #FF759F); }
.notif.warning .notif-fill { background: linear-gradient(90deg, #A86D32, #F7C363); }
