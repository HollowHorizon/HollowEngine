#ide-root {
    background: none;
}

.project-tree-panel.drop-target {
    background: rgba(88, 123, 174, 0.20);
}

#ide-toolbar {
    size: 100% fit;
    padding: 1px 4px 1px 2px;
    gap: 2px;
    background: #141518;
}

#ide-logo {
    size: 24px 24px;
    align-items: center center;
    border-radius: 4px;
    rotate: 0 0 0;
    scale: 0.9;
    transition: all 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

#ide-logo:hover {
    rotate: 0 0 360;
    scale: 1.2;
}

.ide-toolbar-divider {
    size: 1px 14px;
    margin: 0px 6px;
    background: #2B2E35;
}

.ide-toolbar-group {
    gap: 1px;
    background: #1C1E22;
    border-radius: 4px;
}

.ide-toolbar-button {
    size: fit fit;
    margin: 1px;
    padding: 4px;
    border-radius: 3px;
    background: #00000000;
    transition: background 110ms ease-out;
}

.ide-toolbar-button:hover {
    background: #2B2E35;
}

.ide-toolbar-button.active {
    background: #2E3544;
}

.ide-toolbar-button-icon {
    size: 13px 13px;
    tint: #aeb8ca;
    transition: all 110ms ease-out;
}

.ide-toolbar-button:hover .ide-toolbar-button-icon,
.ide-toolbar-button.active .ide-toolbar-button-icon {
    tint: #ffffff;
}

.ide-panel, .ide-empty-editor, .ide-editor-shell {
    size: fill fill;
    margin: 2px;
    padding: 4px;
    border-radius: 6px;
    gap: 6px;
    background: #1C1E22;
}

.ide-editor-shell {
    padding: 2px;
    background: #212328;
}

.ide-empty-editor {
    align-items: center center;
    background: #212328;
}

.game-viewport-hint {
    foreground: #8d96a8;
    text-align: center;
}

.project-filter-row {
    size: fill fit;
    padding: 0px 4px;
    gap: 4px;
    align-items: start center;
    background: #212328;
    border-radius: 4px;
}

.project-filter-icon {
    size: 14px 14px;
    tint: #FFFFFF;
}

.project-filter {
    grow: 1;
    margin-top: 2px;
    align: center center;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

.ide-empty-title {
    foreground: #8f9bad;
    height: 18px;
}

#ide-status-bar {
    padding: 0px 8px;
    gap: 12px;
    align-items: start center;
    background: #141518;
}

.ide-breadcrumbs {
    gap: 2px;
    align-items: start center;
}

.ide-breadcrumb {
    size: fit 16px;
    padding: 0px 4px;
    gap: 4px;
    align-items: start center;
    border-radius: 3px;
    background: #00000000;
    foreground: #8f9bad;
    transition:
            background 100ms ease-out,
            foreground 100ms ease-out;
}

.ide-breadcrumb.last {
    foreground: #d7deea;
}

.ide-breadcrumb.link:hover {
    background: #2B2E35;
    foreground: #f0f3f8;
}

.ide-breadcrumb-icon {
    size: 11px 11px;
}

.ide-breadcrumb-separator {
    size: 8px 8px;
    shape: path("M 3 1 L 6 4 L 3 7", 8 8);
    fill: none;
    stroke: #4f5968;
    stroke-width: 1px;
}

.ide-status-message {
    max-width: 360px;
    foreground: #aeb8ca;
}

.ide-status-detail {
    wrap: false;
    foreground: #8f9bad;
}

.ide-status-detail.version {
    foreground: #4f5968;
}

.ide-shortcuts-dialog {
    padding: 12px;
}

.ide-shortcuts-content {
    gap: 3px;
    padding: 0px 8px 0px 0px;
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.ide-shortcuts-title {
    margin-bottom: 4px;
    font-size: 14px;
    foreground: #F0F3F8;
}

.ide-shortcuts-group {
    margin-top: 6px;
    font-size: 10px;
    foreground: #8f9bad;
}

.ide-shortcuts-row {
    min-height: 20px;
    padding: 0px 6px;
    gap: 12px;
    background: #2A2E36;
    border-radius: 3px;
}

.ide-shortcuts-description {
    width: 0px;
    foreground: #d7deea;
}

.ide-shortcuts-keys {
    wrap: false;
    padding: 1px 5px;
    font-size: 10px;
    foreground: #F0F3F8;
    background: #3A3F49;
    border: 1px #4b5362;
    border-radius: 3px;
}

.ui-profiler-panel {
    gap: 4px;
}

.ui-profiler-toolbar {
    width: 100%;
    height: fit;
    gap: 4px;
}

.ui-profiler-button {
    width: fit;
    height: fit;
    padding: 3px 8px;
    background: #31343D;
    border-radius: 3px;
    foreground: #d7deea;
}

.ui-profiler-button:hover {
    background: #414653;
}

.ui-profiler-scroll {
    width: 100%;
    background: #1d2026;
    padding: 6px;
}

.ui-profiler-report {
    width: fit;
    height: fit;
    white-space: pre;
    font-size: 10px;
    foreground: #d7deea;
}

.tool-window-header {
    size: 100% 24px;
    padding: 0px 4px 0px 8px;
    gap: 2px;
    align-items: start center;
}

.tool-window-title {
    margin: 0px 8px 0px 4px;
}

.tool-window-tab {
    size: fit 18px;
    padding: 0px 8px;
    gap: 5px;
    align-items: center center;
    border-radius: 4px;
    background: #00000000;
    foreground: #8f9bad;
    transition:
            background 110ms ease-out,
            foreground 110ms ease-out;
}

.tool-window-tab:hover {
    background: rgba(255, 255, 255, 0.06);
    foreground: #e4e9f1;
}

.tool-window-tab.selected {
    background: rgba(110, 155, 220, 0.20);
    foreground: #f0f3f8;
}

.tool-window-tab.selected:hover {
    background: rgba(110, 155, 220, 0.26);
}

.tool-window-tab-count {
    min-width: 12px;
    padding: 2px 4px 0px 4px;
    text-align: center;
    border-radius: 6px;
    background: #2B2E35;
    foreground: #aeb8ca;
}

.tool-window-tab-count.has-errors {
    background: rgba(255, 135, 135, 0.16);
    foreground: #ff8787;
}

.tool-window-tab-count.has-warnings {
    background: rgba(255, 194, 102, 0.14);
    foreground: #ffc266;
}

.ide-panel.console-panel {
    padding: 0px;
    gap: 0px;
}

.console-toolbar {
    size: fit 22px;
    padding: 0px 3px;
    gap: 5px;
    align-items: start center;
}

.console-level-dropdown {
    min-width: 64px;
    height: 18px;
    padding: 0px 6px;
}

.console-mode-dropdown {
    min-width: 84px;
    height: 20px;
    padding: 0px 6px;
    background: #212328;
    border: 1px #2B2E35;
    border-radius: 4px;
}

.console-command-row {
    width: 100%;
    height: fit;
    min-height: 26px;
    padding: 3px 6px 5px 6px;
    gap: 4px;
}

.console-filter, .console-command {
    padding: 2px 5px;
    background: #212328;
    border: 1px #2B2E35;
    border-radius: 4px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

/*
 * The whole log is one read-only field; its colours come from the console's own highlighter. It sits
 * a shade lighter than the header and the command line around it, like the editor does.
 */
.console-log {
    width: 100%;
    padding: 2px 8px;
    background: #212328;
    foreground: #d7deea;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.console-empty, .problems-empty {
    align-items: center center;
    background: #212328;
    foreground: #687588;
}

.console-button {
    size: 22px 22px;
    border-radius: 4px;
    background: #00000000;
    transition: background 110ms ease-out;
}

.console-button:hover {
    background: #2B2E35;
}

.console-button.disabled, .console-button.disabled:hover {
    background: #00000000;
}

.console-button-icon {
    size: 13px 13px;
    tint: #d7deea;
}

.console-button.disabled .console-button-icon {
    tint: #687588;
}

.project-context-menu {
    padding: 4px;
    gap: 1px;
}

.project-context-menu-item {
    width: 100%;
    min-height: 18px;
    padding: 0px 5px;
}

.project-context-menu-icon {
    size: 14px 14px;
}

.project-context-menu-label {
    wrap: false;
}

.project-name-dialog {
    gap: 5px;
    padding: 5px;
}

.project-name-dialog-title {
    height: 18px;
    foreground: #d7deea;
}

.project-name-dialog-input {
    caret-color: #f0f6ff;
    background: #1E2127;
    border-radius: 4px;
    border: 1px #5F6677;
    selection-color: rgba(95, 140, 205, 0.46);
}

.project-name-dialog-actions {
    gap: 3px;
}

.project-actions {
    size: fit 100%;
    padding: 0px 2px;
    gap: 1px;
    align-items: center center;
}

.project-action {
    size: fit fit;
    margin: 2px 0px;
    padding: 3px;
    border-radius: 3px;
    background: #00000000;
    transition: background 110ms ease-out;
}

.project-action:hover {
    background: #2B2E35;
}

.project-action-icon {
    size: 13px 13px;
    tint: #aeb8ca;
}

.project-action:hover .project-action-icon {
    tint: #ffffff;
}

.project-dialog-content {
    margin: 6px;
    gap: 7px;
}

.project-dialog-title {
    foreground: #F0F3F8;
    font-size: 14px;
}

.project-dialog-field {
    gap: 2px;
}

.project-dialog-scroll {
    gap: 7px;
    padding: 0px 8px 0px 0px;
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.project-dialog-label {
    foreground: #8f9bad;
    font-size: 10px;
}

.project-dialog-input {
    padding: 2px 5px;
    background: #1E2127;
    border: 1px #4b5362;
    border-radius: 3px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

.project-dialog-dropdown {
    height: 22px;
    padding: 0px 6px;
    background: #1E2127;
    border: 1px #4b5362;
    border-radius: 3px;
}

.project-dialog-dependencies {
    padding: 3px 5px;
    gap: 2px;
    background: #1E2127;
    border-radius: 3px;
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.project-dialog-checkbox-row {
    gap: 7px;
    foreground: #D7DEEA;
}

.project-dialog-text {
    foreground: #D7DEEA;
    font-size: 11px;
    line-spacing: 2px;
}

.project-dialog-hint, .project-dialog-progress {
    foreground: #8f9bad;
    font-size: 10px;
    line-spacing: 2px;
}

.project-dialog-warning {
    foreground: #ffc266;
    font-size: 11px;
    line-spacing: 2px;
}

.project-dialog-error {
    foreground: #ff8787;
    font-size: 11px;
    line-spacing: 2px;
}

.project-dialog-path-row {
    gap: 6px;
}

.project-dialog-path {
    foreground: #aeb8ca;
    font-size: 10px;
}

.project-dialog-actions {
    gap: 6px;
    margin-top: 3px;
}

.project-dialog-button {
    min-width: 72px;
    padding: 0px 10px;
    border-radius: 4px;
    border: 1px #E7EBF2;
    background: #3A3F49;
    transition: background 80ms ease-out;
}

.project-dialog-button:hover {
    background: #4A515E;
}

.project-dialog-button.primary {
    background: #5F8CCD;
    foreground: #FFFFFF;
}

.project-dialog-button.primary:hover {
    background: #6E9BDC;
}

.project-dialog-button.disabled, .project-dialog-button.disabled:hover {
    background: #2C3038;
    foreground: #687588;
    border: 1px #4b5362;
}

.ide-hide-toolbar-dialog {
    padding: 12px;
}

.ide-hide-toolbar-dialog-content {
    gap: 10px;
}

.ide-hide-toolbar-dialog-title {
    foreground: #F0F3F8;
    font-size: 14px;
}

.ide-hide-toolbar-dialog-message {
    foreground: #B9C1CF;
    font-size: 11px;
    line-spacing: 2px;
}

.ide-hide-toolbar-dialog-checkbox-row {
    gap: 7px;
    foreground: #D7DEEA;
}

.ide-hide-toolbar-dialog-actions {
    gap: 6px;
}

.ide-hide-toolbar-dialog-button {
    border-radius: 4px;
    border: 1px #E7EBF2;
    background: #3A3F49;
    transition: background 80ms ease-out;
}

.ide-hide-toolbar-dialog-button:hover {
    background: #4A515E;
}

.ide-hide-toolbar-dialog-button:active {
    background: #303640;
}

.ide-hide-toolbar-dialog-button.primary {
    background: #5F8CCD;
    foreground: #FFFFFF;
}

.ide-hide-toolbar-dialog-button.primary:hover {
    background: #6E9BDC;
}

.ide-hide-toolbar-dialog-button.primary:active {
    background: #4D78B8;
}

.ide-editor-stack {
    size: 100% 100%;
}

.code-editor {
    line-spacing: 2px;
    inlay-hints: true;
}

/* Inlays are measured as they are drawn, so everything about their size lives here. */
.code-editor-inlay {
    height: fit;
    padding: 0px 3px;
    gap: 3px;
    align-items: center center;
    background: #1A1C20;
    margin-left: 2px;
    margin-right: 4px;
    border-radius: 3px;
}

.code-editor-inlay-text {
    /* A share of the code font, so the hints follow ctrl+wheel along with the text. */
    font-size: 85%;
    foreground: rgba(142, 153, 171, 0.9);
    text-wrap: false;
}

.code-editor-inlay-icon {
    size: 9px 9px;
    align-y: center;
    tint: rgba(142, 153, 171, 0.9);
    transition: all 170ms ease-in-out;
}

.code-editor-inlay.inlay-action {
    transition: all 170ms ease-in-out;
}

.code-editor-inlay.inlay-action:hover {
    background: #2B2E35;
}

.code-editor-inlay.inlay-action:hover .code-editor-inlay-icon {
    tint: #FFFFFF;
}

.code-editor-inlay.color-hint {
    padding: 1px;
    background: #00000000;
    margin-left: 0px;
    margin-right: 2px;
    border: 1px rgba(255, 255, 255, 0.22);
    border-radius: 3px;
}

.code-editor-inlay.color-hint:hover {
    background: #00000000;
    border: 1px #FFFFFF;
}

.code-editor-inlay-swatch {
    size: 8px 8px;
    border-radius: 2px;
}


.ide-find-bar {
    width: 100%;
    height: fit;
    gap: 3px;
    padding: 3px;
    background: #1C1E22;
    border-radius: 4px;
}

.ide-find-row {
    width: 100%;
    height: fit;
    min-height: 22px;
    gap: 4px;
}

.ide-find-icon {
    size: 14px 14px;
    tint: #aeb8ca;
}

.ide-find-input {
    height: 20px;
    padding: 2px 5px;
    background: #212328;
    border: 1px #2B2E35;
    border-radius: 3px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

.ide-find-toggle {
    size: 20px 20px;
    border-radius: 3px;
    foreground: #8f9bad;
    background: #00000000;
    transition: all 110ms ease-out;
}

.ide-find-toggle:hover {
    background: #414653;
}

.ide-find-toggle.on {
    background: rgba(67, 106, 154, 0.62);
    foreground: #f0f6ff;
}

.ide-find-toggle-label {
    wrap: false;
    font-size: 10px;
}

.ide-find-status {
    width: fit;
    min-width: 58px;
    wrap: false;
    foreground: #8f9bad;
}

.ide-find-status.empty {
    foreground: #ff8787;
}

.ide-find-button {
    size: 20px 20px;
    border-radius: 3px;
    background: #00000000;
    transition: background 110ms ease-out;
}

.ide-find-button:hover {
    background: #414653;
}

.ide-find-button-icon {
    size: 11px 11px;
    tint: #aeb8ca;
}

.ide-find-text-button {
    width: fit;
    height: 20px;
    padding: 0px 8px;
    background: #414653;
    foreground: #d7deea;
    border-radius: 3px;
}

.ide-find-text-button:hover {
    background: #5f6b80;
}


.ide-search-overlay {
    padding: 5px;
    gap: 4px;
    background: #24272E;
    border: 1px #5F6677;
    border-radius: 6px;
    shadow: 2px 4px 12px 0px rgba(0, 0, 0, 0.55);
}

.ide-search-scopes {
    width: 100%;
    height: fit;
    gap: 3px;
    align-items: start center;
}

.ide-search-scope {
    width: fit;
    height: 20px;
    padding: 0px 10px;
    border-radius: 3px;
    foreground: #8f9bad;
    background: #00000000;
    transition: all 110ms ease-out;
}

.ide-search-scope:hover {
    background: #414653;
}

.ide-search-scope.on {
    background: rgba(67, 106, 154, 0.62);
    foreground: #f0f6ff;
}

.ide-search-status {
    width: fit;
    wrap: false;
    foreground: #687588;
}

.ide-search-query-row {
    width: 100%;
    height: fit;
    gap: 5px;
    padding: 0px 4px;
    background: #1E2127;
    border: 1px #4b5362;
    border-radius: 4px;
}

.ide-search-icon {
    size: 14px 14px;
    tint: #aeb8ca;
}

.ide-search-input {
    height: 24px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

.ide-search-results {
    width: 100%;
    max-height: 320px;
    gap: 1px;
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.ide-search-result {
    width: 100%;
    height: fit;
    min-height: 20px;
    padding: 2px 6px;
    gap: 6px;
    border-radius: 3px;
}

.ide-search-result:hover {
    background: rgba(84, 124, 176, 0.42);
}

.ide-search-result.selected {
    background: rgba(67, 106, 154, 0.62);
}

.ide-search-result-icon {
    size: 14px 14px;
}

.ide-search-result-name {
    width: fit;
    wrap: false;
    foreground: #d7deea;
}

.ide-search-result-detail {
    width: 0px;
    grow: 1;
    wrap: false;
    font-size: 10px;
    foreground: #687588;
}

.ide-search-result-match {
    foreground: #ffc266;
}

.ide-diagnostics-badge {
    height: fit;
    margin: 4px 10px 0px 0px;
    padding: 3px 5px;
    align-items: center center;
    gap: 4px;
    background: rgba(28, 30, 34, 0.88);
    border: 1px #2B2E35;
    border-radius: 4px;
    translate: 0 0 20px;
    foreground: #d7deea;
    transition: background 120ms ease-out;
}

.ide-diagnostics-badge:hover {
    background: #2B2E35;
}

.problems-file {
    size: 100% 22px;
    padding: 0px 6px 0px 10px;
    gap: 5px;
    align-items: start center;
}

.problems-file-icon {
    size: 12px 12px;
}

.problems-file-name {
    margin-right: 4px;
    wrap: false;
    foreground: #d7deea;
}

.problem-count-icon {
    size: 9px 9px;
}

.problem-count {
    margin-right: 3px;
    foreground: #8f9bad;
}

.problem-count.has-errors {
    foreground: #ff8787;
}

.problem-count.has-warnings {
    foreground: #ffc266;
}

.problems-list {
    padding: 2px 4px 4px 4px;
    background: #212328;
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.problem-row {
    size: 100% 20px;
    padding: 0px 4px 0px 22px;
    gap: 6px;
    align-items: start center;
    border-radius: 3px;
    background: #00000000;
    transition: background 100ms ease-out;
}

.problem-row:hover {
    background: #2B2E35;
}

.problem-icon {
    size: 10px 10px;
}

.problem-message {
    width: 0px;
    grow: 1;
    foreground: #d7deea;
}

.problem-location {
    wrap: false;
    foreground: #687588;
}

.problem-copy {
    size: 16px 16px;
    border-radius: 3px;
    background: #00000000;
    transition: background 100ms ease-out;
}

.problem-copy:hover {
    background: rgba(255, 255, 255, 0.08);
}

.problem-copy-icon {
    size: 10px 10px;
    tint: #687588;
}

.problem-row:hover .problem-copy-icon,
.problem-copy:hover .problem-copy-icon {
    tint: #d7deea;
}

.file-context-menu {
    padding: 4px;
    gap: 1px;
}

.file-context-menu-item {
    width: 100%;
    min-height: 18px;
    padding: 0px 5px;
}

.file-context-menu-icon {
    size: 14px 14px;
}

.file-context-menu-label {
    wrap: false;
}

.file-context-menu-separator {
    width: 100%;
    height: 1px;
    margin: 2px 0px;
    background: #3a3f4b;
}

.drag-ghost {
    width: fit;
    height: fit;
}

.drag-ghost-content {
    gap: 4px;
    padding: 2px 6px;
    background: #24272ECC;
    border: 1px #5F6677;
    border-radius: 4px;
    shadow: 1px 1px 3px 0px rgba(0, 0, 0, 0.42);
}

.drag-ghost-icon {
    size: 14px 14px;
}

.drag-ghost-label {
    wrap: false;
    foreground: #d7deea;
}
