@import "hollowengine:ui/styles/theme.hss";

.animator-button {
    size: 100% 22px;
    align-items: center;
    justify-content: center;
    padding: 4px 6px;
    background: $bg-selected;
    border: 1px alpha($white, 0.1);
    border-radius: $radius-small;
    cursor: hand;
    transition: background 250ms ease-out, border-color 250ms ease-out;
}

.animator-button:hover {
    background: $bg-pressed;
    border-color: $border-strong;
}

.animator-button-label {
    font-size: 9px;
    foreground: $text-strong;
    text-wrap: false;
    text-overflow: dots;
}

.animator-icon-button {
    padding: 3px;
    background: transparent;
    border-radius: $radius-small;
    tint: $text-soft;
    cursor: hand;
    transition: background 110ms ease-out, tint 110ms ease-out;
}

.animator-icon-button:hover {
    background: $bg-hover;
    tint: $white;
}

.animator-icon-button.active {
    background: $bg-selected;
    tint: $accent;
}

.animator-icon-button.active:hover {
    background: $bg-selected;
}

.viewport-toolbar {
    padding: 2px;
    gap: 1px;
    background: alpha($bg-window, 0.86);
    border-radius: $radius;
}

.animator-pill {
    padding: 5px 3px;
    background: $bg-selected;
    border: 1px alpha($white, 0.1);
    border-radius: $radius-small;
    cursor: hand;
    transition: background 250ms ease-out, border-color 250ms ease-out;
}

.animator-pill:hover {
    background: $bg-pressed;
    border-color: $text-strong;
}

.animator-pill.active {
    background: $accent-soft;
    border-color: alpha($white, 0.1);
}

.animator-pill-label {
    font-size: 8px;
    foreground: $text-strong;
    text-wrap: false;
}

.animator-layer-row {
    size: 100% 30px;
    align-items: center;
    gap: 4px;
    padding: 4px;
    background: $bg-field;
    border: 1px alpha($white, 0.1);
    border-radius: $radius-small;
    cursor: hand;
    transition: background 250ms ease-out, border-color 250ms ease-out;
}

.animator-layer-row:hover {
    background: $bg-hover;
}

.animator-layer-row.open {
    background: $row-selected;
}

.animator-layer-row.selected {
    border-color: $accent;
}

.animator-delete {
    size: 18px 18px;
    align-items: center;
    justify-content: center;
    border-radius: $radius-small;
    background: transparent;
    cursor: hand;
    transition: background 250ms ease-out;
}

.animator-delete:hover {
    background: $danger;
}

.animator-delete-label {
    font-size: 11px;
    foreground: $danger;
    transition: foreground 250ms ease-out;
}

.animator-delete:hover .animator-delete-label {
    foreground: $text-strong;
}

.animator-splitter {
    size: 4px 100%;
    background: alpha($white, 0.1);
    cursor: resize-horizontal;
    transition: background 250ms ease-out;
}

.animator-splitter:hover {
    background: $accent;
}

.animator-node {
    border-radius: $radius;
    cursor: hand;
    transition: border-color 250ms ease-out;
}

.animator-node:hover {
    border-color: $text;
}

.animator-minimap-mark {
    border-radius: 2px;
    cursor: hand;
    transition: background 250ms ease-out;
}

.animator-edge-label {
    padding: 3px;
    background: $bg-field;
    border: 1px alpha($white, 0.1);
    border-radius: $radius-small;
    cursor: hand;
    transition: background 250ms ease-out, border-color 250ms ease-out;
}

.animator-edge-label:hover {
    background: $bg-hover;
    border-color: $text;
}

.animator-edge-label.selected {
    border-color: $accent;
}
