#xml-demo {
    size: 100% 100%;
    min-size: 0px 0px;
    background: linear-gradient(135deg, rgba(18, 26, 38, 0.98), rgba(34, 72, 82, 0.92), rgba(54, 48, 86, 0.9));
    border-radius: 10px;
    padding: 18px;
    clip: true;
}

.xml-title {
    position: 24px 20px;
    foreground: #d8f7ff;
    height: 18px;
}

.xml-body {
    position: 24px 48px;
    foreground: rgba(236, 242, 248, 0.92);
    size: 420px 34px;
}

.xml-rich-text {
    position: 24px 84px;
    size: 430px 42px;
    foreground: rgba(236, 242, 248, 0.92);
    text-align: justify;
}

.xml-inline-chip {
    padding: 2px 7px;
    size: auto 17px;
    background: rgba(88, 168, 154, 0.98);
    foreground: white;
    border-radius: 6px;
    border: 1px rgba(188, 255, 244, 0.64);
}

.xml-slot-text {
    position: 24px 134px;
    size: 430px 78px;
    foreground: rgba(236, 242, 248, 0.92);
}

.xml-slot-note {
    padding: 6px;
    size: 58px 36px;
    background: rgba(246, 250, 254, 0.94);
    foreground: rgba(30, 36, 50, 0.98);
    border-radius: 8px;
    border: 1px rgba(255, 255, 255, 0.7);
}

.xml-popup-anchor {
    position: 484px 32px;
    padding: 8px;
    size: 118px 32px;
    background: rgba(72, 150, 142, 0.96);
    foreground: white;
    border-radius: 7px;
    border: 1px rgba(184, 255, 244, 0.68);
}

.xml-popup {
    gap: 4px;
    padding: 9px;
    size: 112px auto;
    background: rgba(246, 250, 254, 0.96);
    foreground: rgba(30, 36, 50, 0.98);
    border-radius: 8px;
    border: 1px rgba(255, 255, 255, 0.7);
    shadow: 0px 14px 26px -8px rgba(0, 0, 0, 0.55);
}

.xml-button {
    position: 24px 226px;
    align-items: center center;
    size: 104px 34px;
    padding: 8px;
    background: rgba(72, 150, 142, 0.96);
    foreground: white;
    border-radius: 7px;
    border: 1px rgba(184, 255, 244, 0.68);
    transition:
        scale 140ms ease-out,
        background 140ms ease-out;
}

.xml-button:hover {
    scale: 1.04;
    background: rgba(86, 174, 164, 1);
}

.xml-button.secondary {
    position: 142px 226px;
    background: rgba(72, 82, 108, 0.94);
    border: 1px rgba(196, 210, 238, 0.48);
}

.xml-button.secondary:hover {
    background: rgba(92, 104, 136, 0.98);
}

.xml-badge {
    position: 284px 222px;
    gap: 7px;
    size: 248px 78px;
    padding: 12px;
    background: rgba(246, 250, 254, 0.94);
    foreground: rgba(30, 36, 50, 0.98);
    border-radius: 8px;
    border: 1px rgba(255, 255, 255, 0.7);
    shadow: 0px 14px 26px -8px rgba(0, 0, 0, 0.55);
}

.xml-badge-title {
    foreground: rgba(24, 38, 58, 0.98);
    height: 16px;
}

.xml-badge-body {
    foreground: rgba(58, 68, 84, 0.92);
}

.xml-log {
    foreground: rgba(210, 246, 226, 0.96);
    height: 16px;
}

.xml-notice {
    position: 24px 276px;
    gap: 5px;
    size: 248px 64px;
    padding: 10px;
    background: rgba(44, 58, 78, 0.92);
    foreground: rgba(236, 242, 248, 0.94);
    border-radius: 8px;
    border: 1px rgba(144, 182, 214, 0.38);
}

.xml-notice[tone=success] {
    background: rgba(38, 88, 76, 0.96);
    border: 1px rgba(160, 246, 216, 0.48);
}

.xml-notice-title {
    foreground: white;
    height: 16px;
}

.xml-notice-body {
    foreground: rgba(226, 248, 240, 0.9);
}

.xml-metric {
    position: 284px 314px;
    align-items: center center;
    size: 248px 26px;
    padding: 5px 9px;
    background: rgba(18, 26, 38, 0.66);
    foreground: rgba(236, 242, 248, 0.96);
    border-radius: 7px;
    border: 1px rgba(255, 255, 255, 0.16);
}

.xml-metric[data-kind=metric] {
    shadow: 0px 10px 20px -12px rgba(0, 0, 0, 0.65);
}

.xml-metric-label {
    foreground: rgba(154, 220, 208, 0.96);
    width: 92px;
}

.xml-metric-value {
    foreground: rgba(246, 250, 254, 0.98);
    grow: 1;
}
