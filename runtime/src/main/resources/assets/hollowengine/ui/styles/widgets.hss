.dropdown-button {
    height: 24px;
    padding: 0px 8px;
    gap: 6px;
    foreground: #cbd3df;
    border-radius: 4px;
    transition:
        background 100ms ease-out,
        foreground 100ms ease-out;
}

.dropdown-button:hover {
    background: rgba(255, 255, 255, 0.08);
    foreground: #ffffff;
}

.dropdown-button[expanded="true"] {
    background: rgba(255, 255, 255, 0.10);
    foreground: #ffffff;
}

.dropdown-button[expanded="true"] .dropdown-button-arrow {
    rotate: 0px 0px 180px;
    fill: #ffffff;
}

.dropdown-button-icon,
.dropdown-item-icon,
.tree-icon {
    size: 16px 16px;
    tint: #ffffff;
}

.dropdown-item-check {
    size: 10px 10px;
    checkbox-active: #6E9BDC;
    checkbox-mark: #ffffff;
    border: 1px #4A505C;
}

/* Fills the free space of a button wider than its text, so the arrow sits flush against the right edge. */
.dropdown-button-label {
    grow: 1;
    wrap: false;
}

.dropdown-button-arrow {
    size: 7px 5px;
    shape: path("M 0 0 L 7 0 L 3.5 5 Z", 7 5);
    fill: #9aa5b7;
    transition:
        rotate 120ms ease-out,
        fill 120ms ease-out;
}

.dropdown-popup {
    min-width: 140px;
    padding: 3px;
    gap: 1px;
    align-items: stretch;
    background: #26282E;
    border: 1px #3A3E48;
    border-radius: 6px;
    shadow: 0px 6px 16px 0px rgba(0, 0, 0, 0.45);
}

.dropdown-item {
    width: 100%;
    gap: 6px;
    padding-vertical: 2px;
    padding-horizontal: 8px;
    border-radius: 4px;
    background: #00000000;
    transition:
        background 80ms ease-out;
}

.dropdown-item-label {
    grow: 1;
}

.dropdown-item-shortcut {
    wrap: false;
    align: end center;
    margin-left: 18px;
    font-size: 10px;
    foreground: #7f8a9d;
}

.dropdown-separator {
    size: fill 1px;
    margin: 2px 6px;
    background: #353841;
}

.dropdown-item:hover {
    background: rgba(110, 155, 220, 0.18);
}

.dropdown-item.open {
    background: rgba(110, 155, 220, 0.18);
}

.dropdown-item.disabled {
    opacity: 0.42;
}

.tree-view {
    clip: true;
}

.tree-view-scroll {
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.tree-filter-row {
    width: 100%;
    height: 22px;
    margin-bottom: 3px;
    padding: 1px 4px;
    gap: 3px;
    align-items: start center;
    background: #212328;
    border-radius: 4px;
}

.tree-filter-icon, .tree-filter-close {
    size: 12px 12px;
    tint: #aeb8ca;
}

.tree-filter-input {
    min-height: 18px;
    padding: 2px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

.tree-filter-close:hover {
    tint: #ffffff;
}

.tree-item {
    padding-right: 6px;
    background: #00000000;
    foreground: #aeb8ca;
    border-radius: 3px;
    transition:
        background 200ms ease-out,
        foreground 200ms ease-out;
    animations: tree-row-in 110ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes tree-row-in {
    from { opacity: 0; translate: 0 -4 0; }
    to   { opacity: 1; translate: 0 0 0; }
}

.tree-item:hover {
    background: rgba(255, 255, 255, 0.07);
    foreground: #ffffff;
}

.tree-item.selected {
    background: rgba(88, 123, 174, 0.32);
    foreground: #ffffff;
}

.tree-item.drop-target {
    background: rgba(88, 123, 174, 0.55);
    foreground: #ffffff;
}

.tree-item.drop-rejected {
    background: rgba(190, 60, 60, 0.35);
}

.tree-indent {
    size: 16px 100%;
    fill: none;
    stroke: #34363C;
    stroke-width: 1px;
}

.tree-indent.line {
    shape: path("M 7.5 0 L 7.5 20", 16 20);
}

.tree-indent.end {
    shape: path("M 7.5 0 L 7.5 10", 16 20);
}

.tree-indent.branch {
    shape: path("M 7.5 0 L 7.5 20 M 7.5 6 Q 7.5 10 11.5 10 L 15 10", 16 20);
}

.tree-indent.last {
    shape: path("M 7.5 0 L 7.5 6 Q 7.5 10 11.5 10 L 15 10", 16 20);
}

.tree-expander {
    size: 12px 12px;
    margin: 0px 2px;
    shape: path("M 3 2 L 8 6 L 3 10", 12 12);
    fill: none;
    stroke: #7f8a9d;
    stroke-width: 1.5px;
    transition:
        rotate 120ms ease-out,
        fill 100ms ease-out;
}

.tree-expander[expanded="false"] {
    rotate: 0px 0px 0px;
}

.tree-expander[expanded="true"] {
    rotate: 0px 0px 90px;
}

.tree-expander-empty {
    size: 12px 12px;
    margin: 0px 2px;
}

.tree-label {
    height: fit;
    margin-left: 4px;
    align: start center;
    wrap: false;
}

.text-field {
    padding: 4px 3px;
    min-height: 18px;
}

.code-editor {
    padding: 8px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
    line-numbers: true;
    line-number-color: #4f5968;
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.editable-text-field-gutter {
    background: #212328;
}

.editable-text-field-inlay {
    height: fit;
    padding: 0px 1px;
    gap: 3px;
    align-items: start center;
    background: #1A1C20;
}

.editable-text-field-inlay-text {
    font-size: 70%;
    foreground: #687588;
    text-wrap: false;
    padding: 0px 2px;
}

.editable-text-field-inlay-icon {
    size: 12px 12px;
    align-y: center;
    tint: #687588;
}

.overlay-scrim {
    background: rgba(8, 9, 12, 0.46);
    backdrop-filter: blur(8px);
    animations: overlay-scrim-in 140ms ease-out both;
}

@keyframes overlay-scrim-in {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.ui-tooltip {
    max-width: 260px;
    padding: 3px 7px;
    background: #26282E;
    border: 1px #3A3E48;
    border-radius: 5px;
    shadow: 0px 4px 12px 0px rgba(0, 0, 0, 0.45);
}

.ui-tooltip-label {
    foreground: #d7deea;
}

.ide-quick-fix-popup {
    padding: 3px;
    gap: 1px;
    background: #26282E;
    border: 1px #3A3E48;
    border-radius: 6px;
    shadow: 0px 6px 16px 0px rgba(0, 0, 0, 0.45);
}

.ide-quick-fix-row {
    width: 100%;
    height: fit;
    min-height: 18px;
    padding: 2px 8px;
    border-radius: 4px;
    foreground: #d7deea;
    text-wrap: false;
}

.ide-quick-fix-row.selected {
    background: rgba(110, 155, 220, 0.24);
}

.ide-quick-fix-row:hover {
    background: rgba(110, 155, 220, 0.18);
}

.ide-quick-fix-label {
    text-wrap: false;
}

.editable-text-field-inlay-swatch {
    size: 8px 8px;
    border-radius: 2px;
}

.ide-completion-popup {
    background: #26282E;
    border: 1px #3A3E48;
    border-radius: 6px;
    shadow: 0px 6px 16px 0px rgba(0, 0, 0, 0.45);
    clip: true;
}

.ide-completion-divider {
    background: #2B2E35;
}

.ide-completion-list {
    size: 100% 100%;
    text-wrap: false;
    scrollbar: 4px;
    scrollbar-margin: 2px;
    scrollbar-overlay: true;
    scrollbar-track: none;
    scrollbar-thumb: rgba(155, 169, 194, 0.28);
    scrollbar-thumb-hover: rgba(175, 188, 210, 0.6);
    scrollbar-hover-thickness: 6px;
    scrollbar-thumb-radius: 4px;
}

.ide-completion-hint {
    width: 100%;
    padding: 0px 8px;
    gap: 5px;
    align-items: start center;
    font-size: 85%;
    foreground: #687588;
}

.ide-completion-hint-icon {
    size: 10px 10px;
    tint: #687588;
}

.ide-completion-hint-key {
    foreground: #aeb8ca;
}

.ide-completion-row {
    width: 100%;
    padding: 0px 8px;
    gap: 6px;
    align-items: start center;
    text-wrap: false;
    clip: true;
}

.ide-completion-row:hover {
    background: rgba(255, 255, 255, 0.05);
}

.ide-completion-row.selected {
    background: rgba(110, 155, 220, 0.24);
}

.ide-completion-row.selected:hover {
    background: rgba(110, 155, 220, 0.30);
}

.ide-completion-icon {
    size: 12px 12px;
    tint: rgba(160, 188, 230, 0.9);
}

.ide-completion-item {
    size: 14px 14px;
}

.ide-completion-main {
    grow: 1;
    clip: true;
    align-items: start center;
}

.ide-completion-text {
    gap: 0px;
    align-items: start center;
}

.ide-completion-label {
    foreground: #d7deea;
    text-wrap: false;
}

.ide-completion-detail {
    foreground: rgba(169, 181, 198, 0.88);
    text-wrap: false;
}

.ide-completion-tail {
    foreground: #5F6A7B;
    text-wrap: false;
    align: end center;
}

.ide-code-insight-popup {
    padding: 6px 8px;
    background: #26282E;
    border: 1px #3A3E48;
    border-radius: 6px;
    shadow: 0px 6px 16px 0px rgba(0, 0, 0, 0.45);
}

.ide-active-parameter {
    background: rgba(110, 155, 220, 0.24);
    border-radius: 2px;
}

.ide-hover-documentation {
    foreground: #A9B3C4;
}

.ide-diagnostic-tooltip {
    padding: 5px 8px;
    align-items: start center;
    background: #26282E;
    border: 1px #3A3E48;
    border-radius: 6px;
    shadow: 0px 6px 16px 0px rgba(0, 0, 0, 0.45);
    clip: false;
}

.ide-diagnostic-tooltip.error {
    border: 1px rgba(224, 108, 108, 0.55);
}

.ide-diagnostic-tooltip.warning {
    border: 1px rgba(230, 179, 90, 0.5);
}

.ide-diagnostic-tooltip.info {
    border: 1px rgba(110, 155, 220, 0.5);
}

/* Its size is the editor's, set in code. */
.ide-diagnostic-tooltip-message {
    foreground: #d7deea;
    text-wrap: true;
}

.timeline-keyframe-visual {
    scale: 1;
    stroke: #17191f;
    stroke-width: 1px;
    shadow: 0px 0px 2px 0px rgba(130, 164, 220, 0.28);
    transition:
        scale 160ms ease-out,
        stroke 160ms ease-out,
        shadow 160ms ease-out;
}

.timeline-keyframe:hover .timeline-keyframe-visual {
    scale: 1.12;
    stroke: #dbe5f5;
    shadow: 0px 0px 3px 0px rgba(145, 183, 242, 0.48);
}

.timeline-keyframe.selected .timeline-keyframe-visual {
    scale: 1.12;
    stroke: #ffffff;
    shadow: 0px 0px 4px 0px rgba(165, 201, 255, 0.72);
}
