/*
 * The dialogue window. Everything the player sees is decided here: the composable side only says
 * which pieces exist, so re-skinning the dialogue means editing this file and nothing else.
 *
 * A `.ui.kts` script that declares `screen("hollowengine:dialogue")` replaces the whole screen; a
 * resource pack that overrides this file re-skins the built-in one.
 *
 * The closing animations are what `DialogueScreenUi.EXIT_DURATION_MILLIS` reserves time for — the
 * screen is taken away when that runs out, so lengthening one of them means raising it too.
 */

/* ------------------------------------------------------------------ the screen */

#dialogue-root {
    size: fill fill;
    align-items: center center;
}

/* A dim plus a light blur: enough to push the world back without hiding it. */
#dialogue-dim {
    size: fill fill;
    align: center center;
    background: rgba(0, 0, 0, 0.30);
    backdrop-filter: blur(3px);
    input-transparent: true;
    animations: dim-in 260ms ease-out both;
}

#dialogue-root:closing #dialogue-dim {
    animations: dim-out 220ms ease-in both;
}

@keyframes dim-in {
    from { opacity: 0; }
    to   { opacity: 1; }
}

@keyframes dim-out {
    from { opacity: 1; }
    to   { opacity: 0; }
}

/* ------------------------------------------------------------------ the text window */

/*
 * One animation, overshooting easing and all: the engine clamps `opacity` while it interpolates, so
 * a springy curve can carry the transform past its target without the alpha following it there.
 */
#dialogue-box {
    size: fit fit;
    width: 62%;
    max-width: 440px;
    min-height: 52px;
    margin: 0px 0px 8px 0px;
    align: center end;
    align-items: start start;

    background: image("hollowengine:textures/gui/dialogues/dialogue_box.png");
    image-fit: 9-slice 30px 8px 30px 8px;
    padding: 14px 12px 8px 12px;

    perspective: 700px;
    transform-origin: 50% 100%;
    animations: box-in 700ms cubic-bezier(0.34, 1.76, 0.64, 1) both;
}

#dialogue-root:closing #dialogue-box {
    animations: box-out 720ms ease-in both;
}

@keyframes box-in {
    from { opacity: 0; translate: 0 22 0; rotate: 26 0 0; }
    to   { opacity: 1; translate: 0 0 0;  rotate: 0 0 0; }
}

@keyframes box-out {
    from { opacity: 1; translate: 0 0 0;  rotate: 0 0 0; }
    to   { opacity: 0; translate: 0 18 0; rotate: 12 0 0; }
}

/*
 * The name plate rides on the top edge of the window, the way the old dialogue box had it. It hangs
 * outside the window's box on a negative margin — the layer the window composites through reserves
 * room for that overhang (see `layerOverflows`), so the plate is not cut off while it animates.
 */
#dialogue-name {
    size: fit fit;
    min-height: 18px;
    height: 16px;
    margin: -29px 0px 7px -6px;
    padding: 0px 10px 0px 10px;
    align-items: center center;

    background: image("hollowengine:textures/gui/dialogues/character_name.png");
    image-fit: 9-slice 7px;

    perspective: 400px;
    transform-origin: 0% 100%;
    animations: name-in 700ms ease-out both;
}

#dialogue-root:closing #dialogue-name {
    animations: box-out 700ms ease-in both;
}

@keyframes name-in {
    from { opacity: 0; translate: -10 6 0; rotate: 0 -22 0; }
    to   { opacity: 1; translate: 0 0 0;   rotate: 0 0 0; }
}

.dialogue-name-text {
    font-size: 7px;
    color: #ffdca8;
}

#dialogue-body {
    size: fill fit;
    align-items: start start;
}

.dialogue-text {
    size: fill fit;
    font-size: 9px;
    color: #f4ece0;
    line-spacing: 2px;
    text-wrap: true;
}

/*
 * The part that has not been typed yet still takes part in the layout, only invisibly. That is what
 * keeps a word from hopping to the next line the moment its last letter arrives.
 */
.dialogue-text-pending {
    color: transparent;
}

/*
 * The mirrored cursor at the right edge, telling the reader the line is over.
 *
 * It is always in the tree and merely invisible: mounting it only when the line finishes would
 * change the box's height and make the window twitch between lines.
 */
#dialogue-continue {
    size: 11px 12px;
    align: end end;
    scale: -1 1;
    image-fit: contain;
    input-transparent: true;
    opacity: 0;
}

#dialogue-continue:ready {
    animations: continue-nudge 900ms ease-in-out infinite;
}

@keyframes continue-nudge {
    0%   { opacity: 0.35; translate: 0 0 0; }
    50%  { opacity: 1.00; translate: -3 0 0; }
    100% { opacity: 0.35; translate: 0 0 0; }
}

/* ------------------------------------------------------------------ the menu */

/*
 * The scroll area is bounded to the middle of the screen. Its mask fades whatever leaves that band
 * instead of cutting it off, and the scrollbar is gone entirely — the wheel and dragging the list
 * are the way around it.
 */
#choice-viewport {
    size: fit fit;
    width: 300px;
    height: 132px;
    align: center center;
    margin: 0px 0px 40px 0px;

    scroll: vertical;
    clip: true;
    scrollbar: 0px;
    scrollbar-track: transparent;
    scrollbar-thumb: transparent;

    mask: linear-gradient(to bottom, transparent, white 26%, white 74%, transparent);
}

/* Padded from the code, by half a viewport, so the first and last option can reach dead centre. */
#choice-list {
    size: fill fit;
    align-items: center start;
    gap: 4px;
}

.choice {
    size: fit fit;
    gap: 4px;
    align-items: center center;
    margin-left: 22px;
    transform-origin: 50% 50%;
    animations: choice-in 340ms ease-out both;
    transitions:
        scale 110ms ease-out,
        opacity 160ms ease-out,
        filter 160ms ease-out;
}

@keyframes choice-in {
    from { opacity: 0; translate: 14 0 0; }
    to   { opacity: 1; translate: 0 0 0; }
}

/* Options come in one after another rather than all at once. */
.choice-0 { animation-delay: 0ms; }
.choice-1 { animation-delay: 70ms; }
.choice-2 { animation-delay: 140ms; }
.choice-3 { animation-delay: 210ms; }
.choice-4 { animation-delay: 280ms; }
.choice-5 { animation-delay: 350ms; }
.choice-6 { animation-delay: 420ms; }
.choice-7 { animation-delay: 490ms; }

.choice-button {
    size: fit fit;
    min-width: 172px;
    height: 24px;
    padding: 0px 14px 0px 14px;
    align-items: center center;

    background: image("hollowengine:textures/gui/dialogues/button.png");
    image-fit: 9-slice 12px;
    cursor: pointer;
}

.choice-text {
    font-size: 9px;
    color: #f6e3c4;
    text-wrap: false;
}

/* Both flanks close in on the button when the option is pointed at, hence the mirrored offsets. */
.choice-desc {
    size: 32px 24px;
    image-fit: contain;
    transitions: translate 110ms ease-out;
}

/* Hidden until the option is pointed at, then it slides in from the right. */
.choice-cursor {
    size: 22px 24px;
    image-fit: contain;
    opacity: 0;
    translate: 8 0 0;
    transitions:
        opacity 110ms ease-out,
        translate 110ms ease-out;
}

.choice:hover { scale: 1.06 1.06; }
.choice:hover .choice-desc { translate: 6 0 0; }
.choice:hover .choice-cursor { opacity: 1; translate: -6 0 0; }
.choice:hover .choice-text { color: #ffffff; }

/*
 * Multiplayer: after this player has voted the options they did not pick lose their colour and stop
 * reacting, so it reads as "no longer yours to decide" rather than as a dead button.
 */
.choice:disabled {
    filter: grayscale(1);
    opacity: 0.55;
}

.choice:selected .choice-text { color: #ffffff; }

/* The vote is in: the losers shrink away first, the winner a beat later so it is clear what won. */
.choice:lost {
    animations: choice-lost 260ms ease-in both;
}

.choice:won {
    animations: choice-won 320ms ease-in both;
    animation-delay: 180ms;
}

@keyframes choice-lost {
    from { opacity: 1; scale: 1 1; }
    to   { opacity: 0; scale: 0.86 0.86; }
}

@keyframes choice-won {
    0%   { opacity: 1; scale: 1.06 1.06; }
    35%  { opacity: 1; scale: 1.12 1.12; }
    100% { opacity: 0; scale: 0.9 0.9; }
}
