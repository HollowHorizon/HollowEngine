{
    "target": "POST",
    "nodes": [
        {
            "id": "uv",
            "type": "hollowengine:input/uv",
            "x": -1020.0,
            "y": -60.0
        },
        {
            "id": "center",
            "type": "hollowengine:input/property",
            "x": -1020.0,
            "y": 220.0,
            "options": {
                "property": "Center"
            }
        },
        {
            "id": "distance",
            "type": "hollowengine:vector/distance",
            "x": -780.0,
            "y": -60.0
        },
        {
            "id": "radius",
            "type": "hollowengine:input/property",
            "x": -780.0,
            "y": 240.0,
            "options": {
                "property": "Radius"
            }
        },
        {
            "id": "width",
            "type": "hollowengine:input/property",
            "x": -780.0,
            "y": 330.0,
            "options": {
                "property": "Width"
            }
        },
        {
            "id": "ring",
            "type": "hollowengine:math/expression",
            "x": -540.0,
            "y": -60.0,
            "options": {
                "expression": "1.0 - smoothstep(0.0, width, abs(d - radius))",
                "type": "float"
            }
        },
        {
            "id": "strength",
            "type": "hollowengine:input/property",
            "x": -540.0,
            "y": 300.0,
            "options": {
                "property": "Strength"
            }
        },
        {
            "id": "warp",
            "type": "hollowengine:math/expression",
            "x": -300.0,
            "y": -60.0,
            "options": {
                "expression": "uv - normalize(uv - center + 0.00001) * ring * strength",
                "type": "vec2"
            }
        },
        {
            "id": "scene",
            "type": "hollowengine:input/scene_color",
            "x": -60.0,
            "y": -60.0
        },
        {
            "id": "shade",
            "type": "hollowengine:math/expression",
            "x": 180.0,
            "y": -60.0,
            "options": {
                "expression": "rgb * (1.0 + ring * strength * 4.0)",
                "type": "vec3"
            }
        },
        {
            "id": "output",
            "type": "hollowengine:output/post",
            "x": 420.0,
            "y": -60.0
        }
    ],
    "links": [
        { "from": "uv", "output": "UV", "to": "distance", "input": "A" },
        { "from": "center", "output": "Out", "to": "distance", "input": "B" },
        { "from": "distance", "output": "Out", "to": "ring", "input": "d" },
        { "from": "radius", "output": "Out", "to": "ring", "input": "radius" },
        { "from": "width", "output": "Out", "to": "ring", "input": "width" },
        { "from": "center", "output": "Out", "to": "warp", "input": "center" },
        { "from": "ring", "output": "Out", "to": "warp", "input": "ring" },
        { "from": "strength", "output": "Out", "to": "warp", "input": "strength" },
        { "from": "warp", "output": "Out", "to": "scene", "input": "UV" },
        { "from": "scene", "output": "RGB", "to": "shade", "input": "rgb" },
        { "from": "ring", "output": "Out", "to": "shade", "input": "ring" },
        { "from": "strength", "output": "Out", "to": "shade", "input": "strength" },
        { "from": "shade", "output": "Out", "to": "output", "input": "Color" }
    ],
    "properties": [
        { "name": "Center", "type": "VEC2", "default": [0.5, 0.5] },
        { "name": "Radius", "default": [0.3] },
        { "name": "Width", "default": [0.06] },
        { "name": "Strength", "default": [0.03] }
    ]
}
